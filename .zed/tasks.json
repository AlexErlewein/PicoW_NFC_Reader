// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Deploy → Pico W",
    "command": "bash scripts/deploy.sh",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "Pico W: REPL öffnen",
    "command": "uv run mpremote repl",
    "reveal": "always"
  },
  {
    "label": "Pico W: Dateien auflisten",
    "command": "uv run mpremote ls :",
    "reveal": "always"
  },
  {
    "label": "Pico W: Soft-Reset",
    "command": "uv run mpremote reset",
    "reveal": "always"
  },
  {
    "label": "MQTT: Topics beobachten (Pi)",
    "command": "mosquitto_sub -h ${MQTT_BROKER:-192.168.1.100} -t 'nfc/#' -v",
    "reveal": "always"
  },
  {
    "label": "uv: Abhängigkeiten installieren",
    "command": "uv sync",
    "reveal": "always"
  },
  {
    "label": "uv: Linter (ruff check)",
    "command": "uv run ruff check .",
    "reveal": "always"
  },
  {
    "label": "uv: Formatter (ruff format)",
    "command": "uv run ruff format .",
    "reveal": "always"
  }
]
